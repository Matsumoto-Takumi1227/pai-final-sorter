<?xml version="1.0"?>
<!-- 仕分け対象の立方体（一辺 2cm）。把持しやすいよう軽量かつ高摩擦にしてある。 -->
<sdf version="1.6">
  <model name="sorting_box_small">
    <link name="link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>6.7e-7</ixx><iyy>6.7e-7</iyy><izz>6.7e-7</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material>
          <ambient>0.95 0.45 0.05 1</ambient>
          <diffuse>0.95 0.45 0.05 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
